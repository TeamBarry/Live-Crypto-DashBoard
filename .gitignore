# =============================================================================
# GITIGNORE
# =============================================================================
# Yeh files Git ko track nahi karni - sirf local development ke liye
# =============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js

# Build output
/dist
/build

# Vite cache
/.vite

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production

# IDE / Editor
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
/coverage

# TypeScript
*.tsbuildinfo

# Cache
.eslintcache
.stylelintcache